{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "__VERSION__",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/nx-alejandrolacasa/mr-pinny",
  "permissions": ["storage", "tabs", "alarms", "offscreen"],
  "icons": { "128": "icons/icon.png" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/toolbar-dark-16.png", "32": "icons/toolbar-dark-32.png" }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "120"
}
